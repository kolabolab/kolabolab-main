{
  "version": 2,
  "name": "kolabolab",
  "buildCommand": "npm run install:all && npm run build:frontend",
  "outputDirectory": "frontend/dist",
  "installCommand": "npm install",
  "env": {
    "NODE_ENV": "production",
    "VITE_API_URL": "https://kolabolab-backend.railway.app/api"
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}