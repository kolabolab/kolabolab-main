{
  "name": "kolabolab",
  "version": "1.0.0",
  "description": "KolaboLab - Tech-for-good collaboration platform",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:backend": "cd backend && npm run start:dev",
    "build": "npm run build:frontend",
    "build:frontend": "cd frontend && npm run build",
    "build:backend": "cd backend && npm run build",
    "start": "cd backend && npm run start:prod",
    "install:all": "npm install && npm run install:frontend && npm run install:backend",
    "install:frontend": "cd frontend && npm install",
    "install:backend": "cd backend && npm install",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "cd frontend && npm run test -- --watchAll=false",
    "test:backend": "cd backend && npm run test",
    "test:cloudflare": "wrangler dev cloudflare-testing.js --local",
    "lint": "npm run lint:frontend && npm run lint:backend",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:backend": "cd backend && npm run lint",
    "clean": "rm -rf frontend/dist backend/dist frontend/node_modules backend/node_modules node_modules",
    "deploy": "./deploy-cloudflare-manual.sh",
    "deploy:staging": "./deploy-cloudflare-manual.sh staging",
    "deploy:production": "./deploy-cloudflare-manual.sh production",
    "deploy:frontend": "./deploy-cloudflare-manual.sh staging true false",
    "deploy:backend": "./deploy-cloudflare-manual.sh staging false true",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ayointegral/kolabolab.git"
  },
  "keywords": [
    "startup",
    "collaboration",
    "tech-for-good",
    "platform",
    "social-impact",
    "react",
    "nestjs",
    "typescript"
  ],
  "author": "KolaboLab Team",
  "license": "MIT"
}